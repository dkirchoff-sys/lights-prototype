<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Smith Home – Lights prototype</title>
<!-- run full-screen from the iPhone/Android home screen -->
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Lights">
<meta name="theme-color" content="#f2f2f6">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --stage:#dcdce2;
  --stage-ink:#6b6b72;
  --surface:#f2f2f6;
  --ink:#404040;
  --ink-2:#636466;
  --ink-menu:#1a1a1a;
  --amber:#f8b541;
  --hair:#dbdbdb;
  --font:-apple-system,"SF Pro Text","SF Pro",BlinkMacSystemFont,"Inter","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --sb:62px;
  --u:118px;
  --spring-bouncy:cubic-bezier(.34,1.56,.64,1);
  --spring-soft:cubic-bezier(.25,1.2,.5,1);
  /* iOS Liquid Glass: translucent body, backdrop blur + saturation, bright specular rim, soft ambient lift */
  --glass-bg:rgba(255,255,255,.4);
  --glass-bg-strong:rgba(255,255,255,.5);
  --glass-fill:linear-gradient(180deg,rgba(255,255,255,.38) 0%,rgba(255,255,255,.04) 55%,rgba(255,255,255,.16) 100%);
  --glass-blur:blur(16px) saturate(2.2);
  --glass-edge:0 0 0 .5px rgba(0,0,0,.05);
  --glass-lift:0 1px 2px rgba(0,0,0,.03),0 8px 22px rgba(0,0,0,.05);
  --glass-sheen:inset 0 1px 0 rgba(255,255,255,.8),inset 0 -1px 0 rgba(255,255,255,.3),inset 0 0 12px rgba(255,255,255,.35);
  color-scheme:light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){ --stage:#1c1c1f; --stage-ink:#9a9aa2; }
}
:root[data-theme="dark"]{ --stage:#1c1c1f; --stage-ink:#9a9aa2; }
html{ height:100%; scroll-padding-top:env(safe-area-inset-top,0px); overscroll-behavior:none; }
*,*::before,*::after{ box-sizing:border-box; }
body{
  margin:0; height:100%; background:var(--stage);
  font-family:var(--font); -webkit-font-smoothing:antialiased;
  display:flex; align-items:center; justify-content:center;
  -webkit-tap-highlight-color:transparent;
  touch-action:manipulation; overscroll-behavior:none;
}
button{ font:inherit; color:inherit; border:0; background:none; padding:0; margin:0; cursor:pointer; }
:focus-visible{ outline:2px solid #3b82f6; outline-offset:2px; }

.stage{ display:flex; flex-direction:column; align-items:center; gap:14px; padding:24px 16px; max-height:100%; }
.hint{ color:var(--stage-ink); font-size:13px; line-height:18px; text-align:center; max-width:402px; margin:0; }

.phone{
  position:relative; width:402px; height:874px; max-height:calc(100dvh - 90px);
  background:var(--surface); border-radius:44px; overflow:hidden;
  box-shadow:0 0 0 1px rgba(0,0,0,.06),0 30px 80px rgba(0,0,0,.18);
  isolation:isolate; user-select:none; -webkit-user-select:none;
}

/* ---------- top bar ---------- */
.topbar{ position:absolute; left:0; right:0; top:0; z-index:5;
  background:linear-gradient(to bottom,rgba(242,242,246,.92),rgba(242,242,246,.55) 62%,rgba(242,242,246,0)); pointer-events:none; }
.topbar > *{ pointer-events:auto; }
.status{ height:var(--sb); display:flex; align-items:center; justify-content:center; padding:2.333px 9px 0; }
.status .time{ flex:1; display:flex; justify-content:center; padding-right:6px; font-weight:600; font-size:17px; line-height:22px; color:#000; }
.status .island{ width:125px; height:37px; border-radius:100px; background:#000; flex:none; }
.status .levels{ flex:1; display:flex; justify-content:center; padding-right:1px; }
.toolbar{ position:relative; height:56px; padding:0 16px 12px; }
.tb-mode{ position:absolute; inset:0 16px 12px; display:flex; align-items:flex-start; justify-content:space-between;
  transition:opacity .2s ease, transform .2s ease; }
.tb-mode[hidden]{ display:flex; opacity:0; pointer-events:none; transform:translateY(-4px); }
.leading{ display:flex; gap:6px; align-items:center; }

.gbtn{ position:relative; height:44px; min-width:44px; padding:4px; border-radius:1000px;
  display:inline-flex; align-items:center; justify-content:center; color:var(--ink);
  background:var(--glass-fill),var(--glass-bg-strong);
  box-shadow:var(--glass-edge),var(--glass-lift),var(--glass-sheen);
  -webkit-backdrop-filter:var(--glass-blur); backdrop-filter:var(--glass-blur);
  transition:transform .12s ease; }
.gbtn:active{ transform:scale(.94); }
.gbtn .sym{ width:36px; height:36px; display:flex; align-items:center; justify-content:center; }
.gbtn.text{ padding:4px 6px; }
.gbtn.text span{ height:36px; padding:0 6px; display:flex; align-items:center; font-weight:510; font-size:17px; }
.title{ display:flex; gap:6px; align-items:center; padding:4px 0; }
.title .label{ height:36px; display:flex; align-items:center; font-weight:510; font-size:17px; color:var(--ink); }
.title .chip{ width:22px; height:22px; border-radius:100px; background:#e8e8eb; display:flex; align-items:center; justify-content:center; }

/* ---------- widgets ---------- */
.scroll{ position:absolute; inset:0; overflow-y:auto; overflow-x:hidden; -webkit-overflow-scrolling:touch;
  padding:calc(var(--sb) + 64px) 16px 140px; scrollbar-width:none; }
.scroll::-webkit-scrollbar{ display:none; }
.grid{ display:grid; grid-template-columns:repeat(3,var(--u)); grid-auto-rows:var(--u); gap:8px; grid-auto-flow:row dense; }

.w{ position:relative; border-radius:26px; outline:none;
  transition:scale .6s var(--spring-bouncy), opacity .2s ease; cursor:pointer; touch-action:none; }
.w.h-axis{ touch-action:pan-y; }
.w:focus-visible{ box-shadow:0 0 0 2px #3b82f6; }
.w.pressed{ scale:.96; transition:scale .14s ease-out; }
.w.dragging{ transition:none; }
.glass{ position:absolute; inset:0; border-radius:26px; overflow:hidden; background:var(--glass-fill),rgba(255,255,255,.28);
  -webkit-backdrop-filter:var(--glass-blur); backdrop-filter:var(--glass-blur);
  box-shadow:var(--glass-edge),var(--glass-lift),var(--glass-sheen); transition:box-shadow .25s ease, background .3s ease; }
.w.on .glass{ background:var(--glass-fill),rgba(255,255,255,.4); }
/* specular rim shared by every glass surface: bright top-left, fading, catching light again bottom-right */
.glass::after,.gbtn::after,.tabbar::after,.orb::after,.menu::after,.del::after{
  content:""; position:absolute; inset:0; z-index:1; border-radius:inherit; pointer-events:none; padding:1px;
  background:linear-gradient(150deg,rgba(255,255,255,.95) 0%,rgba(255,255,255,.4) 28%,rgba(255,255,255,0) 55%,rgba(255,255,255,.6) 100%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); -webkit-mask-composite:xor;
  mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0); mask-composite:exclude; }
.fill{ position:absolute; left:0; bottom:0; background:var(--amber); opacity:0; pointer-events:none;
  transition:height .5s var(--spring-soft), width .5s var(--spring-soft), opacity 0s; }
.w.on .fill{ opacity:.25; transition:height .5s var(--spring-soft), width .5s var(--spring-soft), opacity .12s ease; }
.w.v-axis .fill{ right:0; }
.w.h-axis .fill{ top:0; }
.w.dragging .fill{ transition:opacity .2s ease; }
.content{ position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:calc(100% - 20px); max-width:98px;
  display:flex; flex-direction:column; align-items:center; gap:8px; pointer-events:none; }
.icon{ width:44px; height:44px; display:flex; align-items:center; justify-content:center; }
.icon svg path{ transition:fill .2s ease; }
.copy{ width:100%; text-align:center; font-size:13px; line-height:18px; letter-spacing:-.08px; }
.copy .name{ font-weight:600; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.copy .state{ font-weight:400; color:var(--ink-2); font-variant-numeric:tabular-nums; }
.w.on .copy .state{ color:var(--ink); }

/* edit affordances */
.del,.grab{ position:absolute; z-index:2; opacity:0; transform:scale(.5); pointer-events:none;
  transition:opacity .18s ease, transform .55s var(--spring-bouncy); }
.del{ left:-4px; top:-4px; width:20px; height:20px; padding:1.818px; border-radius:1000px;
  display:flex; align-items:center; justify-content:center;
  background:rgba(108,108,116,.6); -webkit-backdrop-filter:var(--glass-blur); backdrop-filter:var(--glass-blur);
  box-shadow:0 0 0 .5px rgba(0,0,0,.08),0 2px 6px rgba(0,0,0,.08); }
.del::before{ content:""; position:absolute; inset:-12px; }
.grab{ right:-6px; bottom:-6px; width:32px; height:32px; cursor:nwse-resize; touch-action:none; }
.grab::before{ content:""; position:absolute; inset:-10px; }
.grab svg{ display:block; }
.phone.editing .del,.phone.editing .grab{ opacity:1; transform:none; pointer-events:auto; }
.phone.editing .w{ cursor:default; touch-action:auto; }
.w.resizing{ z-index:3; scale:1.02; }
.w.resizing .glass{ box-shadow:var(--glass-edge),0 16px 36px rgba(0,0,0,.12),var(--glass-sheen); }
.w.removing{ scale:.6; opacity:0; transition:scale .2s ease-in, opacity .18s ease; }
.w.added{ animation:pop .7s var(--spring-bouncy); }
@keyframes pop{ from{ transform:scale(.6); opacity:0; } to{ transform:none; opacity:1; } }

.empty{ grid-column:1 / -1; padding:48px 12px; text-align:center; color:var(--ink-2); font-size:15px; line-height:20px; }
.empty b{ display:block; color:var(--ink); font-weight:600; margin-bottom:4px; }

/* ---------- menu ---------- */
.scrim{ position:absolute; inset:0; z-index:8; display:none; }
.scrim.open{ display:block; }
.menu{ position:absolute; z-index:9; right:16px; top:var(--sb); width:238px; padding:10px 8px; border-radius:34px;
  background:var(--glass-fill),rgba(255,255,255,.55); -webkit-backdrop-filter:blur(24px) saturate(2.2); backdrop-filter:blur(24px) saturate(2.2);
  box-shadow:var(--glass-edge),0 12px 40px rgba(0,0,0,.14),var(--glass-sheen);
  transform-origin:calc(100% - 22px) 22px; transform:scale(.3); opacity:0; pointer-events:none;
  transition:transform .28s cubic-bezier(.3,1.25,.5,1), opacity .16s ease; }
.menu.open{ transform:none; opacity:1; pointer-events:auto; }
.mi{ width:100%; height:40px; display:flex; align-items:center; gap:8px; padding:0 8px 0 6px; border-radius:14px; color:var(--ink-menu); text-align:left; }
.mi:hover{ background:rgba(0,0,0,.04); }
.mi:active{ background:rgba(0,0,0,.08); }
.mi .g{ width:28px; display:flex; justify-content:center; flex:none; }
.mi .l{ padding-left:4px; font-size:17px; line-height:20px; letter-spacing:-.43px; }
.sep{ padding:8px 8px 9px; }
.sep div{ height:1px; background:#e6e6e6; }

/* ---------- bottom tabs ---------- */
.tabs{ position:absolute; left:0; right:0; bottom:0; z-index:5; display:flex; gap:8px; align-items:center; justify-content:center;
  padding:12px 21px 21px; background:linear-gradient(to bottom,rgba(242,242,246,0),rgba(242,242,246,.8)); }
.tabbar{ position:relative; width:298px; height:62px; padding:6px 0; display:flex; align-items:center; border-radius:1000px;
  background:var(--glass-fill),var(--glass-bg);
  box-shadow:var(--glass-edge),var(--glass-lift),var(--glass-sheen);
  -webkit-backdrop-filter:var(--glass-blur); backdrop-filter:var(--glass-blur); }
.tab{ position:relative; flex:1 0 0; height:54px; margin-right:-18px; padding-bottom:2px; display:flex; flex-direction:column; align-items:center; justify-content:center; color:var(--ink); }
.tab:last-child{ margin-right:0; }
.tab .sel{ position:absolute; inset:0 4px; border-radius:100px; background:rgba(255,255,255,.7); box-shadow:inset 0 1px 0 rgba(255,255,255,.9),0 1px 3px rgba(0,0,0,.04); opacity:0; transition:opacity .2s ease; }
.tab[aria-selected="true"] .sel{ opacity:1; }
.tab .ti{ position:relative; width:36px; height:36px; margin-bottom:-2px; display:flex; align-items:center; justify-content:center; }
.tab .tl{ position:relative; padding:0 6px; font-weight:600; font-size:10px; line-height:12px; }
.orb{ position:relative; width:62px; height:62px; flex:none; border-radius:1000px; display:flex; align-items:center; justify-content:center;
  background:var(--glass-fill),var(--glass-bg-strong); -webkit-backdrop-filter:var(--glass-blur); backdrop-filter:var(--glass-blur);
  box-shadow:var(--glass-edge),var(--glass-lift),var(--glass-sheen); }
.orb img{ width:70px; height:70px; flex:none; pointer-events:none; }

/* ---------- toast ---------- */
.toast{ position:absolute; left:50%; bottom:112px; z-index:7; transform:translate(-50%,8px); opacity:0; pointer-events:none;
  padding:10px 16px; border-radius:100px; background:rgba(40,40,42,.88); color:#fff; font-size:15px; line-height:20px; white-space:nowrap;
  transition:opacity .2s ease, transform .2s ease; }
.toast.show{ opacity:1; transform:translate(-50%,0); }

/* full-bleed on phones: real status bar replaces the mock one */
@media (max-width:500px){
  body{ align-items:stretch; }
  .stage{ padding:0; width:100%; gap:0; max-height:none; }
  .hint{ display:none; }
  .phone{ width:100%; height:100%; max-height:none; border-radius:0; box-shadow:none; }
  :root{ --sb:0px; background:var(--surface); }
  body{ background:var(--surface); }
  .status{ display:none; }
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{ transition-duration:0s !important; animation:none !important; }
}
</style>
</head>
